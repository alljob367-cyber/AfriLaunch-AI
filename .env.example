# ─── AfriLaunch AI — Environment Variables ──────────────────────────────
# Copy this file to `.env` and fill in the values. NEVER commit `.env`.

# ─── Database (Supabase) ───────────────────────────────────────────────
# REQUIRED for production (Vercel). Without this, all data (users, sessions,
# config) is lost on every cold start.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── App URL ───────────────────────────────────────────────────────────
# The public URL of your deployment (used for redirects, OG metadata, etc.)
NEXT_PUBLIC_APP_URL=https://afrilaunch.ai

# ─── AI Providers (at least one recommended) ───────────────────────────
# Keys are injected at runtime into the in-memory config — they are NEVER
# persisted to the JSON config file.
CEREBRAS_API_KEY=your-cerebras-api-key
OPENROUTER_API_KEY=your-openrouter-api-key
MISTRAL_API_KEY=your-mistral-api-key
GROQ_API_KEY=your-groq-api-key
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key
GEMINI_API_KEY=your-gemini-api-key
ZAI_API_KEY=your-zai-api-key

# ─── Payment Providers (at least one recommended) ─────────────────────
# Flutterwave (Mobile Money for Africa)
FLW_PUBLIC_KEY=your-flutterwave-public-key
FLW_SECRET_KEY=your-flutterwave-secret-key
FLW_ENCRYPTION_KEY=your-flutterwave-encryption-key

# Stripe (international cards)
STRIPE_PUBLISHABLE_KEY=your-stripe-publishable-key
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret

# ─── Communications ────────────────────────────────────────────────────
# Twilio (WhatsApp Agent)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Telegram bot
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ

# ElevenLabs (Voice)
ELEVENLABS_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Email (Resend)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=AfriLaunch AI <noreply@afrilaunch.ai>

# ─── Admin reset (only set when you need to reset the admin password) ──
# Generate with: `openssl rand -hex 32`
# When this env var is set, calling
#   POST /api/admin/password?action=reset
# with body { "resetToken": "<ADMIN_RESET_TOKEN>", "newPassword": "..." }
# will reset the admin password without requiring the old one.
ADMIN_RESET_TOKEN=

# ─── Database (legacy SQLite fallback — local dev only) ───────────────
DATABASE_URL=file:/home/z/my-project/db/custom.db
