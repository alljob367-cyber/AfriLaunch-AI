# ════════════════════════════════════════════════════════════════════
# AfriLaunch AI — Production Environment Variables
# ════════════════════════════════════════════════════════════════════
# Copy this file's contents to your Vercel project settings (or your
# hosting provider's env vars panel). NEVER commit real secrets to git.
#
# Required for production launch (3 blockers):
#   1. Supabase (database persistence)
#   2. AI provider keys (rotate the compromised ones!)
#   3. Payment provider (Flutterwave OR Stripe)

# ─── 1. APP URL (required) ──────────────────────────────────────────
# The public URL of your deployment (used for redirects, OG metadata, sitemap).
NEXT_PUBLIC_APP_URL=https://afrilaunch.ai

# ─── 2. DATABASE — Supabase (REQUIRED for production) ──────────────
# Without this, all data (users, sessions, config, payments) is lost on
# every Vercel cold start. Create a project at https://supabase.com,
# run supabase-schema.sql in the SQL editor, then copy these values.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-from-supabase

# ─── 3. AI PROVIDER — OpenRouter (REQUIRED, single gateway) ───────
# OpenRouter aggregates 300+ models (GPT-5, Claude, Gemini, Mistral, Llama,
# DeepSeek...) under ONE API key. This is the only LLM key you need to manage.
#
# ⚠️ SECURITY: The current OPENROUTER_API_KEY in .env is COMPROMISED (committed
# to git history). You MUST rotate it before launch:
#   1. Go to https://openrouter.ai/keys
#   2. Revoke the old key (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)
#   3. Create a new key
#   4. Add credit to your OpenRouter account (start with $10 — covers ~1000 Pro users)
#   5. Update OPENROUTER_API_KEY in .env + Vercel env vars
#
# Routing by plan (already implemented in lib/ai-runner.ts):
#   Starter    → meta-llama/llama-3.3-70b-instruct:free (free on OpenRouter)
#   Pro        → anthropic/claude-haiku-4.5 ($1/$5 per M tokens)
#   Business   → mistralai/mistral-large-2411 ($2/$6 per M tokens)
#   Enterprise → openai/gpt-5 ($1.25/$10 per M tokens)
OPENROUTER_API_KEY=your-openrouter-api-key

# ─── 3b. OPTIONAL FALLBACK PROVIDERS (emergency backup only) ───────
# These are used ONLY if OpenRouter is completely down (rare).
# You can leave them unset — OpenRouter has 99.9% uptime.
# If you set them, the load balancer will try them as last-resort fallback.
# CEREBRAS_API_KEY=your-cerebras-api-key
# GROQ_API_KEY=your-groq-api-key
# MISTRAL_API_KEY=your-mistral-api-key

# ─── 4. PAYMENT PROVIDER (at least one required for online payments) ─
# Without this, only manual Mobile Money payments work (activation under 24h).
# Test in sandbox first, then switch to production keys.

# Flutterwave (recommended for Africa — Mobile Money + cards)
# Get keys at: https://dashboard.flutterwave.com/dashboard/settings/apis
FLW_PUBLIC_KEY=your-flutterwave-public-key
FLW_SECRET_KEY=your-flutterwave-secret-key
FLW_ENCRYPTION_KEY=your-flutterwave-encryption-key

# Stripe (optional — international cards)
# STRIPE_PUBLISHABLE_KEY=your-stripe-publishable-key
# STRIPE_SECRET_KEY=your-stripe-secret-key
# STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret

# ─── 5. COMMUNICATIONS (required for WhatsApp Agent + Voice + Email) ─

# Twilio (WhatsApp Agent — required for /dashboard/whatsapp-agent)
# Get keys at: https://console.twilio.com
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Telegram bot (required for /dashboard/telegram-link)
# Create bot via @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# ElevenLabs (required for /dashboard/voice — AI voice generation)
# Get key at: https://elevenlabs.io
ELEVENLABS_API_KEY=your-elevenlabs-api-key

# Email (required for receipts, password reset, notifications)
# Resend is recommended (free tier: 100 emails/day)
# Get key at: https://resend.com
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM=AfriLaunch AI <noreply@afrilaunch.ai>

# ─── 6. ADMIN RESET (optional — set only when resetting admin password) ─
# Generate with: openssl rand -hex 32
# When set, calling POST /api/admin/password?action=reset with this token
# resets the admin password without requiring the old one.
ADMIN_RESET_TOKEN=

# ════════════════════════════════════════════════════════════════════
